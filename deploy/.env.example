# Copy to deploy/.env and fill in. deploy/.env is git-ignored; never commit real values.
# Also see the backend repo's deploy/.env.example — APP_DOMAIN and API_DOMAIN there must match
# these values, since Caddy (owned by that repo) routes both domains to these two stacks.

# The backend's public hostname. Baked into the client bundle at build time as the WebSocket
# target (wss://API_DOMAIN/ws) — Next.js rewrites can proxy /api/* same-origin, but not WS upgrades.
API_DOMAIN=api.penyengatadventure.tech

# Internal Docker DNS name of the backend's "api" container on the shared jejak_net network.
# Leave as-is unless the backend stack's service is named differently.
NEXT_PUBLIC_API_BASE_URL=http://api:8080
